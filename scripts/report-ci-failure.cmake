# Print actionable, public annotations instead of just the runner's exit code.
# Build/test output only: never dump environment variables or credentials.
if(NOT DEFINED LOG_FILE OR NOT EXISTS "${LOG_FILE}")
  message("::error title=CI diagnostics::Build/test log was not created")
  return()
endif()
file(STRINGS "${LOG_FILE}" log_lines ENCODING UTF-8)
set(details "")
set(count 0)
foreach(line IN LISTS log_lines)
  if(line MATCHES "[Ff][Aa][Ii][Ll]:|[Ff]atal error|error [A-Z]+[0-9]+|error:|CMake Error|\\*\\*\\*Failed|\\*\\*\\*Exception|[Ss]egmentation fault|[Ss]tack overflow|[Nn]ot [Rr]un|The following tests FAILED|cannot open shared object|Library not loaded|Unable to find executable")
    string(SUBSTRING "${line}" 0 1000 excerpt)
    string(APPEND details "${excerpt}\n")
    math(EXPR count "${count}+1")
    if(count GREATER_EQUAL 10)
      break()
    endif()
  endif()
endforeach()
if(details STREQUAL "")
  list(LENGTH log_lines length)
  math(EXPR first "${length}-20")
  if(first LESS 0)
    set(first 0)
  endif()
  foreach(i RANGE ${first} ${length})
    if(i LESS length)
      list(GET log_lines ${i} line)
      string(APPEND details "${line}\n")
    endif()
  endforeach()
endif()
# Workflow annotation escaping per GitHub's workflow-command format.
string(REPLACE "%" "%25" escaped "${details}")
string(REPLACE "\r" "%0D" escaped "${escaped}")
string(REPLACE "\n" "%0A" escaped "${escaped}")
message("::error title=${STAGE} failed::${escaped}")
if(DEFINED ENV{GITHUB_STEP_SUMMARY})
  file(APPEND "$ENV{GITHUB_STEP_SUMMARY}" "\n### ${STAGE} failure\n\n```text\n${details}```\n\nDownload the eq29-logs artifact for the full output.\n")
endif()
